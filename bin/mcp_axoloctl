#!/usr/bin/env python3
"""Axoloctl MCP Stdio Adapter & CLI Tool.

Supports:
1. Standard MCP JSON-RPC 2.0 protocol over stdio (default or 'mcp' subcommand).
2. Direct CLI subcommands (start, stop, status, list, logs) for operator and
   CI workflows.
"""

import argparse
import json
import os
import sys
import urllib.error
import urllib.request

UDMI_ROOT = os.path.abspath(os.path.join(os.path.dirname(__file__), ".."))
ACTIVE_CONFIG_POINTER = os.path.join(
  UDMI_ROOT, "var", "axoloctl", "active_config.json"
)


def resolve_webmcp_url(config_arg="", port_arg=None):
  """Resolves the target Web MCP HTTP URL from config or environment."""
  if port_arg:
    return f"http://127.0.0.1:{int(port_arg)}/mcp"

  env_port = os.environ.get("AXOLOCTL_WEBMCP_PORT")
  if env_port:
    return f"http://127.0.0.1:{int(env_port)}/mcp"

  cfg_path = config_arg or os.environ.get("AXOLOCTL_CONFIG", "")
  if not cfg_path and os.path.isfile(ACTIVE_CONFIG_POINTER):
    try:
      with open(ACTIVE_CONFIG_POINTER, "r", encoding="utf-8") as f:
        ptr = json.load(f)
        cfg_path = ptr.get("config_path", "")
    except Exception: # pylint: disable=broad-exception-caught
      cfg_path = ""

  if not cfg_path:
    raise RuntimeError(
      "Axoloctl configuration not found. Pass --config <path>, set "
      "AXOLOCTL_CONFIG, or start services via 'bin/tmux_axoloctl start <cfg>'."
    )

  if not os.path.isabs(cfg_path):
    cfg_path = os.path.abspath(os.path.join(UDMI_ROOT, cfg_path))
  if not os.path.isfile(cfg_path):
    raise RuntimeError(f"Axoloctl config file not found: {cfg_path}")

  with open(cfg_path, "r", encoding="utf-8") as f:
    raw = json.load(f)
  if "webmcp_port" not in raw:
    raise RuntimeError(f"Missing 'webmcp_port' in {cfg_path}")
  port = int(raw["webmcp_port"])
  return f"http://127.0.0.1:{port}/mcp"


def send_jsonrpc(webmcp_url, req, bound_tag=""):
  """Forwards a single JSON-RPC 2.0 request to the web_mcp daemon."""
  data = json.dumps(req).encode("utf-8")
  try:
    opener = urllib.request.build_opener(urllib.request.ProxyHandler({}))
    headers = {"Content-Type": "application/json"}
    if bound_tag:
      headers["X-Axoloctl-Tag"] = bound_tag
    req_obj = urllib.request.Request(webmcp_url, data=data, headers=headers)
    with opener.open(req_obj, timeout=20) as response:
      if response.status == 204:
        return None
      body = response.read().decode("utf-8").strip()
      return json.loads(body) if body else None
  except urllib.error.URLError as e:
    return {
      "jsonrpc": "2.0",
      "id": req.get("id"),
      "error": {
        "code": -32603,
        "message": f"Failed to connect to web_mcp daemon at {webmcp_url}: {e}"
      }
    }
  except Exception as e: # pylint: disable=broad-exception-caught
    return {
      "jsonrpc": "2.0",
      "id": req.get("id"),
      "error": {
        "code": -32603,
        "message": f"Internal wrapper error: {e}"
      }
    }


def run_stdio(webmcp_url, bound_tag=""):
  """Main stdio loop reading JSON-RPC lines from stdin and writing to stdout."""
  for line in sys.stdin:
    if not line.strip():
      continue
    try:
      req = json.loads(line)
      res = send_jsonrpc(webmcp_url, req, bound_tag=bound_tag)
      if res is not None:
        print(json.dumps(res), flush=True)
    except json.JSONDecodeError:
      err = {
        "jsonrpc": "2.0",
        "id": None,
        "error": {"code": -32700, "message": "Parse error"}
      }
      print(json.dumps(err), flush=True)


def invoke_cli_tool(webmcp_url, tool_name, arguments, bound_tag):
  """Invokes an MCP tool via JSON-RPC and prints/returns the parsed result."""
  if not bound_tag:
    sys.stderr.write(
      "ERROR: Session tag is required. Pass --tag <tag> or set AXOLOCTL_TAG.\n"
    )
    sys.exit(1)
  req = {
    "jsonrpc": "2.0",
    "id": 1,
    "method": "tools/call",
    "params": {
      "name": tool_name,
      "arguments": arguments
    }
  }
  res = send_jsonrpc(webmcp_url, req, bound_tag=bound_tag)
  if not res:
    sys.stderr.write("Error: Empty response from web_mcp daemon.\n")
    sys.exit(1)
  if "error" in res:
    msg = res["error"].get("message", str(res["error"]))
    sys.stderr.write(f"Error: {msg}\n")
    sys.exit(1)
  result_obj = res.get("result", {})
  content = result_obj.get("content", [])
  if content and "text" in content[0]:
    parsed = json.loads(content[0]["text"])
    print(json.dumps(parsed, indent=2))
    if tool_name == "start_server" and not parsed.get("running", False):
      sys.exit(1)
    return
  print(json.dumps(result_obj, indent=2))


def invoke_cli_list(webmcp_url):
  """Queries GET /status on web_mcp for operator inspection of active sessions."""
  status_url = webmcp_url.rsplit("/", 1)[0] + "/status"
  opener = urllib.request.build_opener(urllib.request.ProxyHandler({}))
  try:
    with opener.open(status_url, timeout=10) as resp:
      data = json.loads(resp.read().decode("utf-8"))
      sessions = data.get("sessions", {})
      servers = [
        {
          "tag": tag,
          "description": info.get("description", ""),
          "url": info.get("url", ""),
          "agent_running": info.get("agent_running", False),
          "workspace": info.get("workspace", ""),
        }
        for tag, info in sessions.items()
      ]
      print(json.dumps({"servers": servers}, indent=2))
  except Exception as e: # pylint: disable=broad-exception-caught
    sys.stderr.write(f"Error querying {status_url}: {e}\n")
    sys.exit(1)


def build_parser():
  """Builds the argument parser for CLI and MCP execution modes."""
  parser = argparse.ArgumentParser(
    description="Axoloctl MCP Server & CLI Lifecycle Controller"
  )
  parser.add_argument(
    "--config",
    default="",
    help="Explicit path to Axoloctl JSON configuration file"
  )
  parser.add_argument(
    "--port",
    type=int,
    default=None,
    help="Explicit web_mcp TCP port override"
  )
  parser.add_argument(
    "--tag",
    default="",
    help="Bound session tag identifier (defaults to AXOLOCTL_TAG environment variable)"
  )
  subparsers = parser.add_subparsers(dest="command")

  subparsers.add_parser("mcp", help="Run in stdio MCP server mode")

  start_p = subparsers.add_parser(
    "start", help="Deploy commit_hash and start the bound session's paired agent & web server"
  )
  start_p.add_argument("commit_hash", help="40-character Git commit SHA")
  start_p.add_argument(
    "description",
    nargs="?",
    default="Managed web server session",
    help="Human-readable session description"
  )

  subparsers.add_parser("stop", help="Stop the bound session's web server")

  subparsers.add_parser(
    "status", help="Get lifecycle status and commit_hash for the bound session"
  )

  subparsers.add_parser("list", help="List all active web server sessions")

  logs_p = subparsers.add_parser(
    "logs", help="Read unified [server] and [browser] logs for the bound session"
  )
  logs_p.add_argument(
    "--cursor", type=int, default=0, help="Zero-based line cursor offset"
  )
  logs_p.add_argument(
    "--max-lines", type=int, default=200, help="Maximum lines to return"
  )
  return parser


def main():
  """Entrypoint for bin/mcp_axoloctl."""
  parser = build_parser()
  args = parser.parse_args()

  try:
    webmcp_url = resolve_webmcp_url(args.config, args.port)
  except RuntimeError as e:
    sys.stderr.write(f"ERROR: {e}\n")
    sys.exit(1)

  bound_tag = (args.tag or os.environ.get("AXOLOCTL_TAG") or "").strip()

  if args.command in (None, "mcp"):
    run_stdio(webmcp_url, bound_tag=bound_tag)
  elif args.command == "start":
    invoke_cli_tool(
      webmcp_url,
      "start_server",
      {
        "commit_hash": args.commit_hash,
        "description": args.description
      },
      bound_tag=bound_tag,
    )
  elif args.command == "stop":
    invoke_cli_tool(webmcp_url, "stop_server", {}, bound_tag=bound_tag)
  elif args.command == "status":
    invoke_cli_tool(webmcp_url, "get_status", {}, bound_tag=bound_tag)
  elif args.command == "list":
    invoke_cli_list(webmcp_url)
  elif args.command == "logs":
    invoke_cli_tool(
      webmcp_url,
      "read_logs",
      {
        "cursor": args.cursor,
        "max_lines": args.max_lines
      },
      bound_tag=bound_tag,
    )


if __name__ == "__main__":
  main()
