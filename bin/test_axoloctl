#!/bin/bash -e
#
# Unit and end-to-end integration test suite for Axoloctl MCP & CLI.
#

UDMI_ROOT=$(cd "$(dirname "$0")/.." && pwd)
cd "$UDMI_ROOT"

source "$UDMI_ROOT/etc/shell_common.sh"

CONFIG_FILE="mcp/axoloctl/etc/gummi_config.json"

cleanup() {
    bin/tmux_axoloctl stop >/dev/null 2>&1 || true
}
trap cleanup EXIT

echo "=========================================================================="
echo "Running Axoloctl Unit Tests..."
echo "=========================================================================="

venv/bin/pytest -v mcp/axoloctl/tests/

echo ""
echo "=========================================================================="
echo "Verifying Fail-Fast Config Enforcement..."
echo "=========================================================================="

if bin/tmux_axoloctl start >/dev/null 2>&1; then
    echo "FAIL: bin/tmux_axoloctl start succeeded without a config file!" >&2
    exit 1
fi
echo "Confirmed fail-fast when no config file is provided."

echo ""
echo "=========================================================================="
echo "Testing Axoloctl Server Control Flow & End-to-End Session Lifecycle..."
echo "=========================================================================="

bin/tmux_axoloctl clean
bin/tmux_axoloctl start "$CONFIG_FILE"

# Wait for daemons to bind
for i in $(seq 1 15); do
    if curl -s -f http://127.0.0.1:9290/api/uis >/dev/null 2>&1 && \
       curl -s -f http://127.0.0.1:9291/status >/dev/null 2>&1; then
        break
    fi
    sleep 0.5
done

echo "Checking UI Discovery & Host UI endpoints (:9290)..."
curl -s -f http://127.0.0.1:9290/api/uis | jq -e '.default_ui == "cliView" and (.uis | length == 3)' >/dev/null
curl -s -f http://127.0.0.1:9290/ui/cli | grep -q "CLI Console"
curl -s -f http://127.0.0.1:9290/ui/hub | grep -q "Web Hub"
curl -s -f http://127.0.0.1:9290/ui/api | grep -q "Custom Chat"

echo "Checking Web MCP stdio handshake (initialize & tools/list)..."
INIT_OUT=$(echo '{"jsonrpc":"2.0","id":1,"method":"initialize","params":{}}' | bin/mcp_axoloctl --config "$CONFIG_FILE" mcp)
echo "$INIT_OUT" | jq -e '.result.serverInfo.name == "udmi-axoloctl"' >/dev/null

TOOLS_OUT=$(echo '{"jsonrpc":"2.0","id":2,"method":"tools/list","params":{}}' | bin/mcp_axoloctl --config "$CONFIG_FILE" mcp)
echo "$TOOLS_OUT" | jq -e '.result.tools | length == 5' >/dev/null

echo "Deploying HEAD commit via bin/mcp_axoloctl start..."
HEAD_SHA=$(git rev-parse HEAD)
START_OUT=$(bin/mcp_axoloctl --config "$CONFIG_FILE" start gummi "$HEAD_SHA" "CI E2E test session")
echo "$START_OUT"
echo "$START_OUT" | jq -e '.running == true and .url == "http://127.0.0.1:9300"' >/dev/null

echo "Probing deployed web server on http://127.0.0.1:9300/..."
curl -s -f http://127.0.0.1:9300/ >/dev/null

echo "Verifying status, list, and logs CLI subcommands..."
STATUS_OUT=$(bin/mcp_axoloctl --config "$CONFIG_FILE" status gummi)
echo "$STATUS_OUT" | jq -e --arg sha "$HEAD_SHA" '.running == true and .commit_hash == $sha' >/dev/null

LIST_OUT=$(bin/mcp_axoloctl --config "$CONFIG_FILE" list)
echo "$LIST_OUT" | jq -e '.servers | length == 1 and .[0].tag == "gummi"' >/dev/null

LOGS_OUT=$(bin/mcp_axoloctl --config "$CONFIG_FILE" logs gummi)
echo "$LOGS_OUT" | jq -e '.running == true and (.lines | length > 0)' >/dev/null

echo "Stopping deployed web server session..."
STOP_OUT=$(bin/mcp_axoloctl --config "$CONFIG_FILE" stop gummi)
echo "$STOP_OUT" | jq -e '.running == false' >/dev/null

bin/tmux_axoloctl stop

echo ""
echo "=========================================================================="
echo "SUCCESS: Axoloctl Test Suite Passed!"
echo "=========================================================================="
