#!/bin/bash -e

set -e

ROOT_DIR=$(realpath $(dirname $0)/..)
GENCODE_DIR="$ROOT_DIR/gencode/python"

source "$ROOT_DIR/venv/bin/activate"

PYTEST_CMD="$ROOT_DIR/venv/bin/pytest"

echo "--- Running generated python class tests ---"
PYTHONPATH="$GENCODE_DIR:${PYTHONPATH:-}" $PYTEST_CMD -v -rA "$ROOT_DIR"/bin/test_generated_classes.py

echo "--- Test run complete ---"